{
  "_comment": "Representative ComfyUI-FluxTrainer LoRA training graph. Validate node class_types/inputs against your installed ComfyUI-FluxTrainer version by exporting a known-good training workflow (Export > API) and replacing this file. Placeholders are filled by server/train-workflow.ts.",
  "1": {
    "class_type": "FluxTrainModelSelect",
    "inputs": {
      "transformer": "flux1-dev.safetensors",
      "vae": "ae.safetensors",
      "clip_l": "clip_l.safetensors",
      "t5": "t5xxl_fp16.safetensors"
    }
  },
  "2": {
    "class_type": "TrainDatasetGeneralConfig",
    "inputs": {
      "color_aug": false,
      "flip_aug": false,
      "shuffle_caption": false,
      "caption_dropout_rate": 0.0
    }
  },
  "3": {
    "class_type": "TrainDatasetAdd",
    "inputs": {
      "dataset_config": ["2", 0],
      "width": "{{RESOLUTION}}",
      "height": "{{RESOLUTION}}",
      "batch_size": 1,
      "dataset_path": "{{DATASET_PATH}}",
      "class_tokens": "{{TRIGGER_WORD}}",
      "num_repeats": 10
    }
  },
  "4": {
    "class_type": "OptimizerConfig",
    "inputs": {
      "optimizer_type": "adamw8bit",
      "max_grad_norm": 1.0,
      "lr_scheduler": "constant",
      "lr_warmup_steps": 0
    }
  },
  "5": {
    "class_type": "InitFluxLoRATraining",
    "inputs": {
      "flux_models": ["1", 0],
      "dataset": ["3", 0],
      "optimizer_settings": ["4", 0],
      "output_name": "{{OUTPUT_NAME}}",
      "output_dir": "/runpod-volume/models/loras",
      "network_dim": "{{RANK}}",
      "network_alpha": "{{RANK}}",
      "learning_rate": "{{LEARNING_RATE}}",
      "max_train_steps": "{{STEPS}}",
      "save_every_n_steps": 0,
      "gradient_checkpointing": true,
      "gradient_dtype": "bf16",
      "save_dtype": "bf16",
      "attention_mode": "sdpa"
    }
  },
  "6": {
    "class_type": "FluxTrainLoop",
    "inputs": {
      "network_trainer": ["5", 0],
      "steps": "{{STEPS}}"
    }
  },
  "7": {
    "class_type": "FluxTrainSave",
    "inputs": {
      "network_trainer": ["6", 0],
      "save_state": false,
      "copy_to_comfy_lora_folder": false
    }
  }
}
