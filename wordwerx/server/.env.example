# Companion server secrets — copy to server/.env and fill in. NEVER commit .env.
# These are read only by the local Node server, never shipped to the browser.

# Server
PORT=8787
# Local asset store dir (relative to server/ or absolute). Default: server/store
STORE_DIR=store

# RunPod API (provisioning + run/status proxy)
# Create at https://console.runpod.io/user/settings -> API Keys
RUNPOD_API_KEY=
# Filled in automatically by scripts/runpod/create-endpoint.mjs
RUNPOD_ENDPOINT_ID=

# RunPod network-volume S3 gateway (LoRA upload/list)
# Create S3 credentials at console.runpod.io -> Settings -> S3 API Keys
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
# Datacenter-specific endpoint, e.g. https://s3api-us-ks-2.runpod.io
RUNPOD_S3_ENDPOINT=https://s3api-us-ks-2.runpod.io
# Datacenter id used as the S3 "region", e.g. US-KS-2
RUNPOD_S3_REGION=US-KS-2
# The network volume id == the S3 bucket name (from create-volume.mjs)
RUNPOD_NETWORK_VOLUME_ID=
